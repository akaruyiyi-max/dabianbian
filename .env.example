# 答辩记录仪 - 环境变量示例
# 复制本文件为 .env 供本地开发使用；部署到 Render 时通过控制台/蓝图设置

# 服务端口（Render 会自动注入，本地默认 3000）
PORT=3000

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 弹幕/提醒定时检查间隔（毫秒）
REMINDER_CHECK_INTERVAL_MS=300000

# Supabase Postgres 连接串（在 Supabase 控制台 Project Settings -> Database 获取）
# 格式：postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# 本地开发把下面整行取消注释并替换为你的连接串；部署到 Render 时在控制台手动填 DATABASE_URL
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
