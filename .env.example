# 答辩记录仪 - 环境变量示例
# 复制本文件为 .env 供本地开发使用；部署到 Render 时通过控制台/蓝图设置

# 服务端口（Render 会自动注入，本地默认 3000）
PORT=3000

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 弹幕/提醒定时检查间隔（毫秒）
REMINDER_CHECK_INTERVAL_MS=300000

# Supabase 项目配置（在 Supabase 控制台 Settings -> API 获取）
# SUPABASE_URL 例如：https://inzuoypiwasnoumspzik.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY 为 Project API keys 里的 anon public key（仅服务端使用）
SUPABASE_ANON_KEY=your-anon-public-key
