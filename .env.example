# 答辩记录仪 - 环境变量示例
# 复制本文件为 .env 供本地开发使用；部署到 Render 时通过控制台/蓝图设置

# 服务端口（Render 会自动注入，本地默认 3000）
PORT=3000

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 弹幕/提醒定时检查间隔（毫秒）
REMINDER_CHECK_INTERVAL_MS=300000

# 数据库路径（Render 挂载持久磁盘后设为 /data/app.db，本地留空即可）
# DB_PATH=/data/app.db
